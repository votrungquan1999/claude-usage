# Shared secret machines and the browser both send. Generate with e.g. `openssl rand -hex 32`.
CLAUDE_USAGE_SECRET=

# MongoDB connection string. Atlas connection strings already carry the db name in the path;
# for local dev against a plain mongod, include a db name in the path too (e.g. .../claude-usage).
MONGODB_URI=

# Optional: overrides the db name from MONGODB_URI's path. Only needed for local/test setups
# (e.g. mongodb-memory-server) where the URI has no path segment.
# MONGODB_DB_NAME=

# Base URL of the deployed app that hooks running on each machine sync to, e.g.
# https://usage.example.com — NOT the /api/sync path itself; the uploader appends that.
CLAUDE_USAGE_API_URL=
